    {"parameters":{"jsCode":"const x=$input.first()?.json??{};const rr=x.rerun_request??{};const affected=[...new Set((rr.requested_modules??rr.impact?.affected_modules??[]).map(v=>String(v).toLowerCase()))];const defs={foundation:['s1_foundation',[],'Frame the revised founder truth and riskiest assumptions.'],customer_demand:['s1_customer_demand',['foundation'],'Refresh affected customer-demand evidence.'],competitor_intelligence:['s1_competitor_intelligence',['foundation'],'Refresh affected competitor evidence and opportunity gaps.'],market_economics:['s1_market_economics',['foundation'],'Refresh affected market structure and accessibility evidence.'],evidence_audit:['s1_evidence_audit',['customer_demand','competitor_intelligence','market_economics'],'Independently audit changed research and citations.'],research_verdict:['s1_research_verdict',['evidence_audit'],'Recalculate the deterministic research verdict.'],assumptions_risks:['s2_assumptions_risks',['research_verdict'],'Re-rank assumptions and risks against the revised goal.'],offer_pricing:['s2_offer_pricing',['assumptions_risks'],'Refresh offer and pricing hypotheses.'],validation_proof:['s2_validation_proof',['assumptions_risks','offer_pricing'],'Refresh validation experiments and thresholds.'],operating_model:['s2_operating_model',['assumptions_risks'],'Refresh feasible operating choices.'],financial_readiness:['s2_financial_readiness',['offer_pricing','operating_model'],'Recalculate transparent founder-input financial scenarios.'],execution_readiness:['s2_action_readiness',['validation_proof','financial_readiness'],'Reassess advisory action-readiness.'],launch_distribution:['s3_launch_distribution',['execution_readiness'],'Refresh MVP, first-customer and distribution guidance.'],growth_optimization:['s3_growth_optimization',['launch_distribution'],'Refresh evidence-labelled growth guidance.'],action_blueprint:['s3_action_blueprint',['execution_readiness','launch_distribution','growth_optimization'],'Regenerate the advisory action blueprint.'],final_blueprint:['s1_research_blueprint',[],'Regenerate the progressive blueprint from all affected outputs.']};const order=Object.keys(defs);const selected=order.filter(m=>affected.includes(m));const keyBy=Object.fromEntries(selected.map(m=>[m,defs[m][0]]));const tasks=selected.map(m=>{const [task_key,deps,goal]=defs[m];let dependency_keys=deps.filter(d=>keyBy[d]).map(d=>keyBy[d]);if(m==='final_blueprint')dependency_keys=selected.filter(d=>d!=='final_blueprint').map(d=>keyBy[d]);const research=['customer_demand','competitor_intelligence','market_economics'].includes(m);return {task_key,module_key:m,goal,plan_decision:'RUN',dependency_keys,input_refs:[{type:'PROFILE_VERSION',version:rr.target_profile_version},{type:'SOURCE_RUN_ID',value:rr.source_run_id},{type:'RERUN_MODE',value:rr.mode}],output_schema_version:['final_blueprint','action_blueprint'].includes(m)?'bp-progressive-blueprint-v1':'bp-task-output-v1',allowed_tools:research?['YOU_SEARCH','DIRECT_WEB']:m==='evidence_audit'?['DIRECT_SOURCE_VERIFY']:m==='financial_readiness'?['DETERMINISTIC_FINANCE']:[],model_role:['research_verdict','financial_readiness'].includes(m)?'NONE':m==='evidence_audit'||m==='assumptions_risks'?'AUDIT':'STRONG',budgets:{max_attempts:3,max_repairs:2,max_tool_calls:research?12:0,timeout_seconds:120},completion_criteria:[{rule:'SCHEMA_VALID'},{rule:'LIMITATIONS_EXPLICIT'},{rule:'EVIDENCE_OR_ASSUMPTION_LABELS_PRESENT'},{rule:'CONTEXTUAL_ACTIONS_ONLY'}]};});return [{json:{...x,tasks,profile_version:Number(rr.target_profile_version),run_id:x.target_run?.id,project_id:x.target_run?.project_id,plan_valid:tasks.length>0&&Boolean(x.target_run?.id),impact_modules:affected}}];"},"id":"e2e20101-0210-4210-8210-0de021000116","name":"Build Dependency-Closed Rerun Plan","type":"n8n-nodes-base.code","typeVersion":2,"position":[1000,-40]},
