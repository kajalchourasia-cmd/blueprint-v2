{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-evidence.dev/schemas/progressive-blueprint.schema.json",
  "title": "Blueprint Progressive Advisory Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_version", "version_kind", "artifact_stage", "profile_version", "status", "product_idea", "stage_progress", "sections", "top_signals", "limitations", "created_at"],
  "properties": {
    "schema_version": { "const": "bp-progressive-blueprint-v1" },
    "artifact_version": { "type": "integer", "minimum": 1 },
    "version_kind": { "enum": ["ORIGINAL", "RESEARCH", "ACTION"] },
    "artifact_stage": { "enum": ["ONBOARDING", "DISCOVER", "PROVE_AND_DESIGN", "ACTION_BLUEPRINT"] },
    "profile_version": { "type": "integer", "minimum": 1 },
    "supersedes_version": { "type": ["integer", "null"], "minimum": 1 },
    "status": { "enum": ["UNRESEARCHED", "IN_PROGRESS", "COMPLETED", "PARTIAL", "HUMAN_REVIEW", "SAFE_FAILED"] },
    "product_idea": { "type": "string", "minLength": 10, "maxLength": 10000 },
    "change_summary": { "type": "string", "minLength": 3, "maxLength": 2000 },
    "stage_progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "completion_percent"],
        "properties": {
          "stage": { "enum": ["DISCOVER", "PROVE_AND_DESIGN", "ACTION_BLUEPRINT"] },
          "status": { "enum": ["PLANNED", "RUNNING", "WAITING_FOUNDER", "COMPLETED", "PARTIAL", "SAFE_FAILED"] },
          "completion_percent": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "sections": { "type": "array", "items": { "$ref": "module-section.schema.json" } },
    "top_signals": { "type": "array", "maxItems": 5, "items": { "$ref": "dashboard-signal.schema.json" } },
    "source_verdict_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
