{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-evidence.dev/schemas/founder-profile.schema.json",
  "title": "Blueprint Founder Profile Version",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "idea_text", "initial_research_selection", "goal_status", "constraints"],
  "properties": {
    "schema_version": { "const": "bp-founder-profile-v2" },
    "owner_id": { "type": ["string", "null"], "format": "uuid" },
    "project_id": { "type": ["string", "null"], "format": "uuid" },
    "profile_version": { "type": "integer", "minimum": 1 },
    "idea_text": { "type": "string", "minLength": 10, "maxLength": 10000 },
    "industry": { "type": ["string", "null"], "maxLength": 200 },
    "stage": { "enum": ["IDEA", "DISCOVERY", "VALIDATING", "BUILDING", "PRE_LAUNCH", "LAUNCHED", "GROWING", "UNKNOWN"] },
    "target_customer_hypothesis": { "type": ["string", "null"], "maxLength": 2000 },
    "geography": { "type": ["string", "null"], "maxLength": 500 },
    "initial_research_selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["user_research", "competitor_research", "market_research"] }
    },
    "goal_status": { "enum": ["MISSING", "DEFAULTED_VALIDATE_DEMAND", "CONFIRMED"] },
    "goal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "description", "priority"],
      "properties": {
        "type": { "enum": ["VALIDATE_DEMAND", "PAID_CUSTOMERS", "CUSTOMER_COUNT", "SIDE_INCOME", "REDUCE_FINANCIAL_BURDEN", "LAUNCH_READINESS", "FUNDRAISING_READINESS", "GROWTH", "CUSTOM"] },
        "description": { "type": "string", "minLength": 3, "maxLength": 2000 },
        "target_value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 100 },
        "horizon_days": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
        "priority": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
      }
    },
    "module_selection": {
      "description": "Internal downstream module selection created after a founder checkpoint; this is not shown as the initial onboarding choice.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "modules"],
      "properties": {
        "mode": { "enum": ["ALL", "SELECTED"] },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/moduleKey" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "SELECTED" } } },
          "then": { "properties": { "modules": { "minItems": 1 } } }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "hours_per_week", "risk_tolerance", "items"],
      "properties": {
        "available_budget": { "type": ["number", "null"], "minimum": 0 },
        "protected_reserve": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "hours_per_week": { "type": ["number", "null"], "minimum": 0, "maximum": 168 },
        "team_size": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
        "risk_tolerance": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
        "items": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "exclusions": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "prior_work": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "document_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "success_definition": { "type": ["string", "null"], "maxLength": 2000 },
    "research_depth": { "enum": ["FAST", "STANDARD", "DEEP"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "moduleKey": {
      "enum": ["foundation", "customer_demand", "competitor_intelligence", "market_economics", "offer_pricing", "assumptions_risks", "operating_model", "validation_proof", "financial_readiness", "launch_distribution", "growth_optimization", "final_blueprint"]
    }
  }
}
