{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-evidence.dev/schemas/blueprint-task.schema.json",
  "title": "Blueprint Orchestrator Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "profile_version", "module_key", "goal", "status", "dependency_ids", "allowed_tools", "budgets", "completion_criteria"],
  "properties": {
    "schema_version": { "const": "bp-task-v1" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "parent_task_id": { "type": ["string", "null"], "maxLength": 200 },
    "run_id": { "type": "string", "format": "uuid" },
    "profile_version": { "type": "integer", "minimum": 1 },
    "module_key": { "type": "string", "minLength": 1, "maxLength": 100 },
    "goal": { "type": "string", "minLength": 3, "maxLength": 2000 },
    "plan_decision": { "enum": ["RUN", "REUSE", "WAIT", "BLOCKED", "NOT_APPLICABLE", "NOT_REQUESTED"] },
    "status": { "enum": ["PLANNED", "BLOCKED", "READY", "RUNNING", "NEEDS_INPUT", "HUMAN_REVIEW", "COMPLETED", "REUSED", "PARTIAL", "STALE", "NOT_APPLICABLE", "SAFE_FAILED", "CANCELLED"] },
    "dependency_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 200 } },
    "input_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 500 } },
    "output_schema_version": { "type": ["string", "null"], "maxLength": 100 },
    "allowed_tools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
    "model_role": { "enum": ["NONE", "FAST", "STRONG", "AUDIT"] },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_retries", "max_repairs", "timeout_seconds"],
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_repairs": { "type": "integer", "minimum": 0, "maximum": 3 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "completion_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 500 } },
    "observation_verdict": { "type": ["string", "null"], "enum": [null, "VALID", "NEEDS_REPAIR", "NEEDS_INPUT", "CONTRADICTORY", "TOOL_FAILED", "NOT_APPLICABLE", "POLICY_DENIED", "BUDGET_EXHAUSTED"] },
    "route_reason": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
