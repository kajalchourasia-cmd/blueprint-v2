{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-evidence.dev/schemas/founder-memory.schema.json",
  "title": "Blueprint Distilled Founder Journey Memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "project_id", "product_version", "memory_type", "content", "source_event_ids", "status", "confirmed_source"],
  "properties": {
    "schema_version": { "const": "bp-founder-memory-v1" },
    "memory_id": { "type": ["string", "null"], "maxLength": 200 },
    "owner_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "product_version": { "enum": ["V1", "V2"] },
    "profile_version": { "type": ["integer", "null"], "minimum": 1 },
    "blueprint_version": { "type": ["integer", "null"], "minimum": 1 },
    "run_id": { "type": ["string", "null"], "format": "uuid" },
    "memory_type": { "enum": ["GOAL", "PREFERENCE", "CONSTRAINT", "CONFIRMED_DECISION", "CORRECTION", "LESSON", "EPISODE_SUMMARY"] },
    "content": { "type": "string", "minLength": 3, "maxLength": 4000 },
    "source_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 200 } },
    "status": { "enum": ["ACTIVE", "SUPERSEDED", "DELETED"] },
    "supersedes_memory_id": { "type": ["string", "null"], "maxLength": 200 },
    "confirmed_source": { "enum": ["FOUNDER_INPUT", "FOUNDER_CORRECTION", "FOUNDER_DECISION", "QUALITY_APPROVED_RUN"] },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_to": { "type": ["string", "null"], "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
