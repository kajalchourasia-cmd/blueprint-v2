{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-evidence.dev/schemas/research-verdict.schema.json",
  "title": "Blueprint Stage 1 Research Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile_version", "requested_streams", "completed_streams", "verdict", "score_status", "dimension_scores", "evidence_coverage", "critical_blockers", "route", "requires_human", "explanation", "calculation_version"],
  "properties": {
    "schema_version": { "const": "bp-research-verdict-v1" },
    "run_id": { "type": ["string", "null"], "format": "uuid" },
    "profile_version": { "type": "integer", "minimum": 1 },
    "requested_streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["user_research", "competitor_research", "market_research"] }
    },
    "completed_streams": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["user_research", "competitor_research", "market_research"] }
    },
    "verdict": { "enum": ["STRONG_GO", "CONDITIONAL_GO", "HOLD_OR_PIVOT", "INSUFFICIENT_EVIDENCE", "LIMITED_VERDICT"] },
    "score_status": { "enum": ["DECISION_CAPABLE", "PROVISIONAL", "WITHHELD"] },
    "research_viability_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_demand", "competitive_opportunity", "market_accessibility"],
      "properties": {
        "user_demand": { "$ref": "#/$defs/dimension" },
        "competitive_opportunity": { "$ref": "#/$defs/dimension" },
        "market_accessibility": { "$ref": "#/$defs/dimension" }
      }
    },
    "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "critical_blockers": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "route": { "enum": ["STAGE_2", "HUMAN_CHECKPOINT", "TARGETED_RESEARCH", "PAUSE", "SAFE_FAIL"] },
    "requires_human": { "type": "boolean" },
    "explanation": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "calculation_version": { "const": "research-viability-v1" },
    "founder_override": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["decision", "reason", "decided_at"],
      "properties": {
        "decision": { "enum": ["TARGETED_VALIDATION", "CONTINUE_ANYWAY", "PAUSE_OR_REVISE"] },
        "reason": { "type": ["string", "null"], "maxLength": 2000 },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "weight", "coverage", "evidence_ids", "unknowns"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_ids": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "unknowns": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
      }
    }
  }
}
