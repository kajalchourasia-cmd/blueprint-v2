{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-evidence.dev/schemas/stage-checkpoint.schema.json",
  "title": "Blueprint Founder Stage Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "run_id", "stage", "gate", "status", "verdict_ref", "message", "available_decisions", "state_version", "profile_version", "expires_at"],
  "properties": {
    "schema_version": { "const": "bp-stage-checkpoint-v1" },
    "checkpoint_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "stage": { "enum": ["DISCOVER", "PROVE_AND_DESIGN"] },
    "gate": { "enum": ["RESEARCH_VERDICT", "EXECUTION_READINESS"] },
    "status": { "enum": ["PENDING", "RESOLVED", "EXPIRED", "CANCELLED"] },
    "verdict_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
    "message": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "available_decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["PROCEED", "TARGETED_VALIDATION", "RUN_MISSING_RESEARCH", "CONTINUE_ANYWAY", "PAUSE_OR_REVISE", "MORE_INFORMATION", "CANCEL"] }
    },
    "decision": { "type": ["string", "null"], "enum": [null, "PROCEED", "TARGETED_VALIDATION", "RUN_MISSING_RESEARCH", "CONTINUE_ANYWAY", "PAUSE_OR_REVISE", "MORE_INFORMATION", "CANCEL"] },
    "decision_reason": { "type": ["string", "null"], "maxLength": 2000 },
    "state_version": { "type": "integer", "minimum": 1 },
    "profile_version": { "type": "integer", "minimum": 1 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "resolved_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
